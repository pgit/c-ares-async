@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# what the headers include on either runtime, and so what c_ares_async::headers links
find_dependency(Threads)
find_dependency(c-ares @C_ARES_ASYNC_CARES_VERSION@ CONFIG)

set(c_ares_async_TLS "@C_ARES_ASYNC_TLS@")
if (c_ares_async_TLS STREQUAL "OpenSSL")
    find_dependency(OpenSSL @C_ARES_ASYNC_OPENSSL_VERSION@)
else()
    find_dependency(ssl CONFIG) # AWS-LC, ssl_ROOT says where
endif()

include("${CMAKE_CURRENT_LIST_DIR}/c_ares_async-targets.cmake")

#
# The runtimes are the components: asio, which is what there is without asking for any, and
# corosio. Each comes as the target of its name, which defines the macro that selects it.
#
#    find_package(c_ares_async 0.1 REQUIRED)                      # c_ares_async::asio
#    find_package(c_ares_async 0.1 REQUIRED COMPONENTS corosio)   # c_ares_async::corosio
#
# Corosio has no installed package of its own yet, so it is up to the one who asks for it to have
# made the targets Boost::corosio and Boost::capy before -- by building Corosio as part of their
# own build, the way this project's own build does.
#
set(c_ares_async_runtimes ${c_ares_async_FIND_COMPONENTS})
if (NOT c_ares_async_runtimes)
    set(c_ares_async_runtimes asio)
endif()

foreach (c_ares_async_runtime IN LISTS c_ares_async_runtimes)
    if (c_ares_async_runtime STREQUAL "asio")
        find_dependency(Boost @C_ARES_ASYNC_BOOST_VERSION@)
        if (NOT TARGET c_ares_async::asio)
            add_library(c_ares_async::asio INTERFACE IMPORTED)
            target_link_libraries(c_ares_async::asio INTERFACE c_ares_async::headers Boost::headers)
            target_compile_definitions(c_ares_async::asio INTERFACE C_ARES_ASYNC_ASIO=1)
        endif()
        set(c_ares_async_asio_FOUND TRUE)
    elseif (c_ares_async_runtime STREQUAL "corosio")
        if (TARGET Boost::corosio AND TARGET Boost::capy)
            if (NOT TARGET c_ares_async::corosio)
                add_library(c_ares_async::corosio INTERFACE IMPORTED)
                target_link_libraries(c_ares_async::corosio INTERFACE c_ares_async::headers
                                                                      Boost::corosio Boost::capy)
                target_compile_definitions(c_ares_async::corosio INTERFACE C_ARES_ASYNC_COROSIO=1)
            endif()
            set(c_ares_async_corosio_FOUND TRUE)
        else()
            set(c_ares_async_corosio_FOUND FALSE)
            string(CONCAT c_ares_async_NOT_FOUND_MESSAGE
                   "c_ares_async::corosio needs the targets Boost::corosio and Boost::capy, which "
                   "have to be there before find_package(c_ares_async)")
        endif()
    else()
        set(c_ares_async_${c_ares_async_runtime}_FOUND FALSE)
        string(CONCAT c_ares_async_NOT_FOUND_MESSAGE
               "c_ares_async has the components asio and corosio, not '${c_ares_async_runtime}'")
    endif()
endforeach()

check_required_components(c_ares_async)
