From c12e027af28a97951b6c5c7c869cc299afc7e5a2 Mon Sep 17 00:00:00 2001
From: Peter Eisenlohr <peter@eisenlohr.org>
Date: Mon, 23 Nov 2026 22:20:14 +0000
Subject: [PATCH] quic: connect() to endpoints, with a name of their own to
 verify, or none

A client that has the address of its server already, and the server's name apart from it, has no
use for a connect() that resolves the host and checks the certificate against that same host. A DNS
resolver is one: c-ares knows its servers by address only, and DNS over QUIC (RFC 9250) takes the
name the certificate is for from elsewhere. Nor could verification be turned off, for testing.

quic::connect(executor, endpoints, host, config) connects to the first of the endpoints that gets
there, and checks the certificate for host -- a name, sent as SNI, or an address. An empty host
checks the chain only, and sends no SNI. Config::tls_verify turns the check off; the warning about
the server certificate that handle_error() logs is left out then, as nothing was decided by it.
Both overloads are connect_to() underneath.

Tests in test_quic.cpp; the guide has a paragraph, and the reference both overloads by their
signatures.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 docs/programmers-guide.rst      |  6 +++
 docs/reference.rst              |  4 +-
 include/anyhttp/quic.hpp        | 19 ++++++++++
 include/anyhttp/quic/client.hpp |  4 ++
 src/quic/client.cpp             | 18 ++++++---
 src/quic/connection.cpp         | 49 +++++++++++++++++++++----
 test/test_quic.cpp              | 65 +++++++++++++++++++++++++++++++++
 7 files changed, 152 insertions(+), 13 deletions(-)

diff --git a/docs/programmers-guide.rst b/docs/programmers-guide.rst
index a3891fe..3323cd7 100644
--- a/docs/programmers-guide.rst
+++ b/docs/programmers-guide.rst
@@ -496,6 +496,12 @@ The ends map onto the contract of :doc:`end-of-body`:
 The two directions are independent. Opening a stream never waits: at the peer's limit,
 :cpp:func:`open_stream() <quic::Connection::open_stream>` fails with :cpp:var:`errors::would_block`.
 A connection is closed when its handle goes away, on the server when the handler returns.
+
+A client that has the address of its server from somewhere else -- a DNS resolver, whose list of
+servers is addresses -- connects to those endpoints with the other overload of
+:cpp:func:`quic::connect`, and gives the name the certificate has to be valid for apart from them.
+An empty name checks the chain only and sends no SNI, and :cpp:member:`quic::Config::tls_verify`
+turns the check off altogether, for testing.
 :cpp:struct:`quic::Config` has the flow control limits and how writes reach the stack, and
 :src:`docs/quic-streams-plan.md` has how all this came about.
 
diff --git a/docs/reference.rst b/docs/reference.rst
index 7ebe438..ceb1f2c 100644
--- a/docs/reference.rst
+++ b/docs/reference.rst
@@ -104,7 +104,9 @@ Plain QUIC streams
 
    #include <anyhttp/quic.hpp>
 
-.. doxygenfunction:: anyhttp::quic::connect
+.. doxygenfunction:: anyhttp::quic::connect(Executor executor, std::string host, std::string port, Config config)
+
+.. doxygenfunction:: anyhttp::quic::connect(Executor executor, std::vector<TcpEndpoint> endpoints, std::string host, Config config)
 
 .. doxygenfunction:: anyhttp::quic::async_connect
 
diff --git a/include/anyhttp/quic.hpp b/include/anyhttp/quic.hpp
index 57862ee..9e26d8b 100644
--- a/include/anyhttp/quic.hpp
+++ b/include/anyhttp/quic.hpp
@@ -33,6 +33,7 @@
 #include <functional>
 #include <memory>
 #include <string>
+#include <vector>
 
 namespace anyhttp::quic
 {
@@ -53,6 +54,12 @@ struct Config
     */
    std::string tls_ca_file;
 
+   /**
+    * Client: whether the server's certificate is verified at all. Without it, any certificate is
+    * taken, from anybody who answers in the server's place -- that is for testing.
+    */
+   bool tls_verify = true;
+
    /**
     * Client: how long the connection may be silent. The server's is server::Config::idle_timeout.
     */
@@ -268,6 +275,18 @@ using ConnectHandler = Completion<Connect>;
 /// \return The error and the connection.
 IoTask<Connection> connect(Executor executor, std::string host, std::string port, Config config);
 
+/// Connects to the first of \p endpoints that gets there, negotiating \c config.alpn, and returns
+/// the connection -- for a client that knows the server's address already, and its name apart
+/// from that. The server's certificate has to be valid for \p host, which is also sent as SNI if
+/// it is a name; an empty \p host checks the chain only, and sends no SNI.
+/// \param executor What the connection runs on.
+/// \param endpoints Where the server is, tried one after the other.
+/// \param host The name or address the server's certificate has to be valid for, or empty.
+/// \param config The protocol, and how to speak it.
+/// \return The error and the connection.
+IoTask<Connection> connect(Executor executor, std::vector<TcpEndpoint> endpoints, std::string host,
+                           Config config);
+
 #if ANYHTTP_ASIO
 /// \cond internal
 void async_connect_any(Executor executor, std::string host, std::string port, Config config,
diff --git a/include/anyhttp/quic/client.hpp b/include/anyhttp/quic/client.hpp
index b3dc622..dbfad5d 100644
--- a/include/anyhttp/quic/client.hpp
+++ b/include/anyhttp/quic/client.hpp
@@ -25,11 +25,15 @@ struct ClientConfig
    std::string alpn;
 
    /// The host the server's certificate has to be valid for: a name, sent as SNI, or an address.
+   /// Empty checks the chain only, and sends no SNI.
    std::string host;
 
    /// The CA certificates to verify the server with, see client::Config::tls_ca_file.
    std::string tls_ca_file;
 
+   /// Whether the server's certificate is verified at all, see Config::tls_verify.
+   bool verify = true;
+
    /// How long the connection may be silent before it is considered dead.
    std::chrono::nanoseconds idle_timeout = std::chrono::seconds{30};
 };
diff --git a/src/quic/client.cpp b/src/quic/client.cpp
index 22438a7..adc25f4 100644
--- a/src/quic/client.cpp
+++ b/src/quic/client.cpp
@@ -89,8 +89,13 @@ struct TlsClientContext
       SSL_CTX_set_alpn_protos(ctx, reinterpret_cast<const unsigned char*>(alpn.data()),
                               static_cast<unsigned int>(alpn.size()));
 
-      tls_load_trusted_cas(ctx, config.tls_ca_file);
-      SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER, nullptr);
+      if (config.verify)
+      {
+         tls_load_trusted_cas(ctx, config.tls_ca_file);
+         SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER, nullptr);
+      }
+      else
+         SSL_CTX_set_verify(ctx, SSL_VERIFY_NONE, nullptr);
    }
 
    ~TlsClientContext()
@@ -244,7 +249,9 @@ int QuicClientSession::init(UdpEndpoint remote, const ClientConfig& config,
    // The certificate has to be valid for the origin, the host of the URL -- also when `remote` is
    // an alternative service it advertised (RFC 7838, section 2.1).
    //
-   if (!tls_set_peer_name(ssl_, config.host))
+   // An empty host leaves the chain to be checked, and nothing to send as SNI.
+   //
+   if (!config.host.empty() && !tls_set_peer_name(ssl_, config.host))
    {
       mloge("init: can't verify certificates for '{}'", config.host);
       return -1;
@@ -352,8 +359,9 @@ void QuicClientSession::signal_ready() { ready_.set(); }
 
 int QuicClientSession::handle_error(int /*rv*/)
 {
-   // X509_V_ERR_INVALID_CALL: the handshake never got as far as verifying anything
-   if (ssl_)
+   // X509_V_ERR_INVALID_CALL: the handshake never got as far as verifying anything. Without
+   // verification there is a result all the same, but nothing was decided by it.
+   if (ssl_ && SSL_get_verify_mode(ssl_) != SSL_VERIFY_NONE)
       if (auto result = SSL_get_verify_result(ssl_);
           result != X509_V_OK && result != X509_V_ERR_INVALID_CALL)
          mlogw("server certificate: {}", X509_verify_cert_error_string(result));
diff --git a/src/quic/connection.cpp b/src/quic/connection.cpp
index 47e946b..da2ba9b 100644
--- a/src/quic/connection.cpp
+++ b/src/quic/connection.cpp
@@ -10,7 +10,9 @@
 #include <boost/system/detail/errc.hpp>
 
 #include <memory>
+#include <type_traits>
 #include <utility>
+#include <vector>
 
 namespace anyhttp::quic
 {
@@ -162,7 +164,14 @@ void Connection::reset() noexcept { impl_.reset(); }
 // connect()
 // =================================================================================================
 
-IoTask<Connection> connect(Executor executor, std::string host, std::string port, Config config)
+namespace
+{
+
+//
+// What connect() makes of either the endpoints it is given or the ones it looks up.
+//
+template <typename Target>
+IoTask<Connection> connect_to(Executor executor, Target target, std::string host, Config config)
 {
    if (config.alpn.empty() || config.alpn.size() > 255)
       co_return std::tuple{make_error_code(errc::invalid_argument), Connection{}};
@@ -170,14 +179,25 @@ IoTask<Connection> connect(Executor executor, std::string host, std::string port
    try
    {
       ClientConfig client_config{.alpn = config.alpn,
-                                 .host = host,
+                                 .host = std::move(host),
                                  .tls_ca_file = config.tls_ca_file,
+                                 .verify = config.tls_verify,
                                  .idle_timeout = config.idle_timeout};
-      auto session = co_await async_connect(
-         std::move(executor), std::move(host), std::move(port), std::move(client_config),
-         [config](QuicSession& s) -> std::unique_ptr<QuicApplication> {
-            return std::make_unique<StreamApplication>(s, config, nullptr);
-         });
+      auto factory = [config](QuicSession& s) -> std::unique_ptr<QuicApplication> {
+         return std::make_unique<StreamApplication>(s, config, nullptr);
+      };
+
+      std::shared_ptr<QuicSession> session;
+      if constexpr (std::is_same_v<Target, std::vector<TcpEndpoint>>)
+         session = co_await async_connect(std::move(executor), std::move(target),
+                                          std::move(client_config), std::move(factory));
+      else
+      {
+         auto host_to_resolve = client_config.host;
+         session =
+            co_await async_connect(std::move(executor), std::move(host_to_resolve),
+                                   std::move(target), std::move(client_config), std::move(factory));
+      }
 
       auto& application = static_cast<StreamApplication&>(*session->application());
       co_return std::tuple{error_code{},
@@ -189,6 +209,21 @@ IoTask<Connection> connect(Executor executor, std::string host, std::string port
    }
 }
 
+} // namespace
+
+IoTask<Connection> connect(Executor executor, std::string host, std::string port, Config config)
+{
+   co_return co_await connect_to(std::move(executor), std::move(port), std::move(host),
+                                 std::move(config));
+}
+
+IoTask<Connection> connect(Executor executor, std::vector<TcpEndpoint> endpoints, std::string host,
+                           Config config)
+{
+   co_return co_await connect_to(std::move(executor), std::move(endpoints), std::move(host),
+                                 std::move(config));
+}
+
 #if ANYHTTP_ASIO
 void async_connect_any(Executor executor, std::string host, std::string port, Config config,
                        ConnectHandler&& handler)
diff --git a/test/test_quic.cpp b/test/test_quic.cpp
index 9b74e48..6ad698a 100644
--- a/test/test_quic.cpp
+++ b/test/test_quic.cpp
@@ -490,6 +490,71 @@ TEST_P(QuicStreams, WHEN_alpn_is_unknown_THEN_connect_fails)
    }());
 }
 
+// -------------------------------------------------------------------------------------------------
+
+//
+// connect() to endpoints the client has already, with the name that the certificate has to be
+// valid for given apart from them: the server is at 127.0.0.2, and "localhost" is one of the
+// names of its certificate, "anyhttp.example" is not.
+//
+TEST_P(QuicStreams, WHEN_connecting_to_endpoints_THEN_the_certificate_is_checked_for_the_name_given)
+{
+   serverConnection = echo_streams;
+   run([&]() -> Task<void> {
+      auto [ec, connection] = co_await quic::connect(
+         context.get_executor(), {server->local_endpoint()}, "localhost", client_config());
+      EXPECT_FALSE(ec) << ec.message();
+      if (!connection)
+         co_return;
+
+      auto [open_ec, stream] = connection.open_stream();
+      std::ignore = co_await stream.write_eof(boost::asio::buffer("named", 5));
+      auto [read_ec, body] = co_await read_all(stream);
+      EXPECT_EQ(body, "named");
+   }());
+}
+
+TEST_P(QuicStreams, WHEN_the_name_given_is_not_the_certificates_THEN_connect_fails)
+{
+   run([&]() -> Task<void> {
+      auto [ec, connection] = co_await quic::connect(
+         context.get_executor(), {server->local_endpoint()}, "anyhttp.example", client_config());
+      EXPECT_TRUE(ec);
+      EXPECT_FALSE(connection);
+   }());
+}
+
+TEST_P(QuicStreams, WHEN_no_name_is_given_THEN_the_chain_is_still_checked)
+{
+   run([&]() -> Task<void> {
+      auto [ec, connection] = co_await quic::connect(
+         context.get_executor(), {server->local_endpoint()}, "", client_config());
+      EXPECT_FALSE(ec) << ec.message();
+
+      // the default trust store, which does not have the test PKI's root
+      auto config = client_config();
+      config.tls_ca_file.clear();
+      auto [untrusted_ec, untrusted] =
+         co_await quic::connect(context.get_executor(), {server->local_endpoint()}, "", config);
+      EXPECT_TRUE(untrusted_ec);
+      EXPECT_FALSE(untrusted);
+   }());
+}
+
+TEST_P(QuicStreams, WHEN_verification_is_off_THEN_any_certificate_is_taken)
+{
+   run([&]() -> Task<void> {
+      // neither trusted nor for this name
+      auto config = client_config();
+      config.tls_ca_file.clear();
+      config.tls_verify = false;
+      auto [ec, connection] = co_await quic::connect(
+         context.get_executor(), {server->local_endpoint()}, "anyhttp.example", config);
+      EXPECT_FALSE(ec) << ec.message();
+      EXPECT_TRUE(connection);
+   }());
+}
+
 TEST_P(QuicStreams, WHEN_http3_is_on_the_same_port_THEN_both_work)
 {
    serverConnection = echo_streams;
